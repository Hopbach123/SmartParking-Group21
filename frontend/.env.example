# Copy to .env.local, choose DEMO or LIVE, then restart Vite.
VITE_PARKING_MODE=DEMO
# LIVE requires the Backend base URL (without /api/parking/status).
# Same-origin example: /backend (reverse proxy required).
VITE_BACKEND_REST_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000/ws/parking
